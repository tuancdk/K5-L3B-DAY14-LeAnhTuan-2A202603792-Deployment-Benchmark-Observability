# Mẫu biến môi trường — dùng: cp .env.example .env  (.env nằm trong .gitignore, KHÔNG commit)
# Trên Railway/Render: đặt các biến này trong dashboard của platform.

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — đặt chuỗi ngẫu nhiên dài, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# Redis — docker compose tự đặt redis://redis:6379/0 cho service agent
REDIS_URL=redis://localhost:6379/0

# Rate limit (request / 60 giây / API key) và cost guard (USD / ngày, UTC)
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
